 bs = micro-batch actually on the GPU; effective batch = bs * accum (gradient accumulation)\n","    ckpt = OUT_DIR / f'{name}_pretrain_ckpt.pt'; final = OUT_DIR / f'{name}_pretrained.pt'\n","    if final.exists() and not FORCE_RETRAIN:\n","        print(f'[{name}] using pretrained weights {final}'); model.load_state_dict(torch.load(final, map_location=DEVICE)); return model\n","    net = dp(_LossModule(model, loss_fn))\n","    if N_GPUS > 1 and USE_MULTI_GPU: print(f'[{name}] pretraining on {N_GPUS} GPUs')\n","    it = WindowBatches(X_unl, bs=bs); itv = WindowBatches(X_unl_val, bs=bs, shuffle=False, drop_last=False)\n","    sch = torch.optim.lr_scheduler.LambdaLR(opt, sched_fn(epochs * math.ceil(len(it) / accum))) if sched_fn else None\n","    scaler = make_scaler(); start, best, best_state = 0, float('inf'), None\n","    if ckpt.exists() and not FORCE_RETRAIN:\n","        s = torch.load(ckpt, map_location=DEVICE)\n","        model.load_state_dict(s['model']); opt.load_state_dict(s['opt']); start, best = s['epoch'], s['best']\n","        best_state = s.get('best_state');  sch is not None and sch.load_state_dict(s['sched'])\n","        print(f'[{name}] resuming pretraining from epoch {start}')\n","    last_ep_s = 0.\n","    for ep in range(start, epochs):\n","        if time_left() < RESERVE_MIN * 60 + 1.2 * last_ep_s:\n","            torch.save(dict(model=model.state_dict(), opt=opt.state_dict(), epoch=ep, best=best, best_state=best_state,\n","                            sched=sch.state_dict() if sch is not None else None), ckpt)\n","            raise OutOfTime(f'{name} pretraining paused at epoch {ep}/{epochs}, checkpoint saved')\n","        model.train(); t0, run = time.time(), 0.\n","        opt.zero_grad(set_to_none=True)\n","        for i, xb in enumerate(it):\n","            with autocast(): loss = net(xb).mean()\n","            scaler.scale(loss / accum).backward()\n","            if (i + 1) % accum == 0 or i + 1 == len(it):\n","                scaler.unscale_(opt); torch.nn.utils.clip_grad_norm_(model.parameters(), 3.0)\n","                scaler.step(opt); scaler.update(); opt.zero_grad(set_to_none=True)\n","                if sch is not None: sch.step()\n","            run += loss.item()\n","        model.eval(); vl = 0.\n","        with torch.no_grad():\n","            for xb in itv:\n","                with autocast(): vl += net(xb).mean().item() * len(xb)\n","        vl /= len(X_unl_val)\n","        flag = ''\n","        if select == 'val' and vl < best: best, best_state, flag = vl, copy.deepcopy(model.state_dict()), ' *'\n","        last_ep_s = time.time() - t0\n","        print(f'[{name}-pretrain] ep {ep+1:4d}/{epochs} train {run/len(it):.4f} val {vl:.4f}{flag} ({last_ep_s:.0f}s)')\n","        if (ep + 1) % save_every == 0 or ep + 1 == epochs:\n","            torch.save(dict(model=model.state_dict(), opt=opt.state_dict(), epoch=ep + 1, best=best, best_state=best_state,\n","                            sched=sch.state_dict() if sch is not None else None), ckpt)\n","    if select == 'val' and best_state is not None: model.load_state_dict(best_state)\n","    torch.save(model.state_dict(), final)\n","    return model\n","\n","def fit_batch_size(model, loss_fn, bs, L, min_bs=4):\n","    # Try one forward/backward at `bs`; halve on CUDA OOM. Model weights/BN stats are restored afterwards.\n","    if DEVICE.type != 'cuda': return bs\n","    state = copy.deepcopy(model.state_dict()); model.train()\n","    while bs >= min_bs:\n","        x = loss = None\n","        try:\n","            x = torch.randn(bs, 12, L, device=DEVICE)\n","            with autocast(): loss = loss_fn(model, x)\n","            loss.backward()\n","            del x, loss; model.zero_grad(set_to_none=True); torch.cuda.empty_cache()\n","            model.load_state_dict(state)\n","            print(f'batch size {bs} fits in GPU memory'); return bs\n","        except (torch.cuda.OutOfMemoryError, RuntimeError) as e:\n","            if 'out of memory' not in str(e).lower() and not isinstance(e, torch.cuda.OutOfMemoryError): raise\n","            del x, loss; model.zero_grad(set_to_none=True); torch.cuda.empty_cache()\n","            print(f'batch size {bs} -> OOM, trying {bs // 2}'); bs //= 2\n","    raise RuntimeError('Even the minimum batch size does not fit; lower CFG_CPC[\"n_anchor\"] or use a smaller d')\n","\n","def bce_probe(m, x):\n","    return F.binary_cross_entropy_with_logits(m(x).float(), torch.zeros(len(x), N_CLASSES, device=x.device))\n","\n","def exp_cpc():\n","    c = CFG_CPC; win = int(c['window_s'] * SAMPLING_RATE)\n","    model = CPCModel(d=c['d'], steps=c['steps']).to(DEVICE)\n","    opt = torch.optim.AdamW(model.parameters(), lr=c['pretrain_lr'], weight_decay=c['wd'])\n","    cpc_fn = lambda m, x: m.cpc_loss(x, c['n_neg'], c['n_anchor'])[0]\n","    micro = fit_batch_size(model, cpc_fn, c['pretrain_bs'], SIG_LEN)\n","    accum = math.ceil(c['pretrain_bs'] / micro)\n","    print(f'CPC pretraining: micro-batch {micro} x {accum} accumulation steps = effective batch {micro * accum}')\n","    model = pretrain_ssl('cpc', model, cpc_fn, opt, None, c['pretrain_epochs'], micro, select='val', accum=accum)\n","\n","    model.add_head(N_CLASSES); model.to(DEVICE)\n","    ft_bs = fit_batch_size(model, bce_probe, c['ft_bs'], win)\n","    # step 1: head only; BN running stats in the encoder keep updating because model.train() is used\n","    for p in list(model.encoder.parameters()) + list(model.rnn.parameters()) + list(model.proj.parameters()):\n","        p.requires_grad_(False)\n","    groups = [dict(params=model.head.parameters(), lr=c['ft_lr'], weight_decay=c['wd'])]\n","    model, _ = train_classifier(model, name='cpc_ft_head', param_groups=groups, epochs=c['head_epochs'], bs=ft_bs,\n","                                win=win, sched='constant', agg='mean')\n","    # step 2: everything, discriminative LRs (factor 10 per group), reduced LR\n","    for p in list(model.encoder.parameters()) + list(model.rnn.parameters()):\n","        p.requires_grad_(True)\n","    lr2 = c['ft_lr'] / 10\n","    groups = [dict(params=model.head.parameters(), lr=lr2, weight_decay=c['wd']),\n","              dict(params=model.rnn.parameters(), lr=lr2 / 10, weight_decay=c['wd']),\n","              dict(params=model.encoder.parameters(), lr=lr2 / 100, weight_decay=c['wd'])]\n","    model, _ = train_classifier(model, name='cpc_ft_full', param_groups=groups, epochs=c['full_epochs'], bs=ft_bs,\n","                                win=win, sched='constant', agg='mean')\n","    torch.save(model.state_dict(), OUT_DIR / 'cpc_finetuned.pt')\n","    return predict(model, Xva, win, agg='mean'), predict(model, Xte, win, agg='mean')\n","\n","if RUN['cpc']:\n","    run_experiment('cpc', exp_cpc)"]},{"cell_type":"markdown","id":"9efc3abf","metadata":{"papermill":{"duration":0.011729,"end_time":"2026-11-26T19:17:09.383457+00:00","exception":false,"start_time":"2026-11-26T19:17:09.371728+00:00","status":"completed"},"tags":[]},"source":["## Experiment 3 — MTECG masked transformer  *(Zhou et al.)*\n","\n","**Pretrain**: AdamW (β=0.9, 0.95), wd 0.05, LR 1e-3, batch 256, cosine + 40 warmup epochs, 25% mask, per-segment-norm target. Final epoch ka encoder use hota hai (MAE convention).\n","\n","**Finetune**: AdamW (β=0.9, 0.999), wd 0.05 (bias/norm/pos par 0), LR 1e-3, layer-wise decay 0.6, DropPath 0.4, cosine + 5 warmup, 50 epochs, BCE. Input = full 10 s (single window)."]},{"cell_type":"code","execution_count":13,"id":"d1846b11","metadata":{"execution":{"iopub.execute_input":"2026-11-26T19:17:09.408529Z","iopub.status.busy":"2026-11-26T19:17:09.408273Z","iopub.status.idle":"2026-11-26T19:17:40.329335Z","shell.execute_reply":"2026-11-26T19:17:40.32791Z"},"papermill":{"duration":30.946545,"end_time":"2026-11-26T19:17:40.341645+00:00","exception":false,"start_time":"2026-11-26T19:17:09.3951+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["batch size 256 fits in GPU memory\n","MTECG pretraining: micro-batch 256 x 1 accumulation steps = effective batch 256\n","[mtecg] pretraining on 2 GPUs\n","[mtecg-pretrain] ep    1/800 train 1.4776 val 0.9517 (10s)\n","[mtecg-pretrain] ep    2/800 train 0.9024 val 0.9103 (10s)\n","[mtecg-pretrain] ep    3/800 train 0.8800 val 0.9026 (10s)\n","[mtecg] mtecg pretraining paused at epoch 3/800, checkpoint saved -> continue next session with RESUME_FROM\n"]}],"source":["def mtecg_param_groups(model, lr, wd, layer_decay):\n","    n_layers = len(model.blocks) + 1\n","    groups = {}\n","    for n, p in model.named_parameters():\n","        if not p.requires_grad: continue\n","        if n in ('cls_token', 'pos_embed') or n.startswith('patch_embed'): lid = 0\n","        elif n.startswith('blocks.'): lid = int(n.split('.')[1]) + 1\n","        else: lid = n_layers\n","        no_wd = p.ndim == 1 or n in ('cls_token', 'pos_embed')\n","        key = (lid, no_wd)\n","        if key not in groups:\n","            groups[key] = dict(params=[], lr=lr * layer_decay ** (n_layers - lid), weight_decay=0. if no_wd else wd)\n","        groups[key]['params'].append(p)\n","    return list(groups.values())\n","\n","def exp_mtecg():\n","    c = CFG_MTECG\n","    arch = dict(seq_len=SIG_LEN, patch=MT_PATCH, dim=c['dim'], depth=c['depth'], heads=c['heads'])\n","    pre = MTECG(**arch, with_decoder=True, dec_dim=c['dec_dim'], dec_depth=c['dec_depth'], dec_heads=c['dec_heads']).to(DEVICE)\n","    decay, no_decay = [], []\n","    for n, p in pre.named_parameters():\n","        (no_decay if p.ndim == 1 or n in ('cls_token', 'pos_embed', 'mask_token', 'dec_pos') else decay).append(p)\n","    opt = torch.optim.AdamW([dict(params=decay, weight_decay=c['pretrain_wd']), dict(params=no_decay, weight_decay=0.)],\n","                            lr=c['pretrain_lr'], betas=(0.9, 0.95))\n","    mae_fn = lambda m, x: m.mae_loss(x, c['mask_ratio'], c['target'])\n","    micro = fit_batch_size(pre, mae_fn, c['pretrain_bs'], SIG_LEN)\n","    accum = math.ceil(c['pretrain_bs'] / micro)\n","    print(f'MTECG pretraining: micro-batch {micro} x {accum} accumulation steps = effective batch {micro * accum}')\n","    n_steps = math.ceil(len(WindowBatches(X_unl, bs=micro)) / accum)          # optimizer steps per epoch\n","    pre = pretrain_ssl('mtecg', pre, mae_fn, opt, lambda total: cosine_warmup(total, c['pretrain_warmup'] * n_steps),\n","                       c['pretrain_epochs'], micro, select='last', accum=accum)\n","\n","    model = MTECG(**arch, drop_path=c['drop_path'], n_out=N_CLASSES, with_decoder=False)\n","    enc_state = {k: v for k, v in pre.state_dict().items() if not k.startswith(('dec_', 'mask_token'))}\n","    missing, unexpected = model.load_state_dict(enc_state, strict=False)\n","    print('loaded pretrained encoder | newly initialised:', missing)\n","    del pre\n","    model.to(DEVICE); ft_bs = fit_batch_size(model, bce_probe, c['ft_bs'], SIG_LEN)\n","    groups = mtecg_param_groups(model, c['ft_lr'] * ft_bs / c['ft_bs'], c['ft_wd'], c['layer_decay'])   # linear LR scaling if bs shrank\n","    model, _ = train_classifier(model, name='mtecg_ft', param_groups=groups, epochs=c['ft_epochs'], bs=ft_bs,\n","                                win=SIG_LEN, sched='cosine', warmup_epochs=c['ft_warmup'], betas=(0.9, 0.999), agg='max')\n","    torch.save(model.state_dict(), OUT_DIR / 'mtecg_finetuned.pt')\n","    return predict(model, Xva, SIG_LEN), predict(model, Xte, SIG_LEN)\n","\n","if RUN['mtecg']:\n","    run_experiment('mtecg', exp_mtecg)"]},{"cell_type":"markdown","id":"5402443a","metadata":{"papermill":{"duration":0.011752,"end_time":"2026-11-26T19:17:40.365125+00:00","exception":false,"start_time":"2026-11-26T19:17:40.353373+00:00","status":"completed"},"tags":[]},"source":["## Experiment 4 — Ablation: xresnet1d101 + Mehari augmentation\n","Same Strodthoff recipe + RRC/TimeOut (p=0.5). Last mein isliye ki time kam pade toh yahi drop ho."]},{"cell_type":"code","execution_count":14,"id"