ion outputs to continue from (e.g. ['/kaggle/input/<your-notebook-output>']). Files are copied, never overwritten.\n","RESUME_FROM = []\n","AMP = 'auto'              # 'auto' = mixed precision on GPU | 'off' = full fp32 (slower, use if NaNs persist)\n","\n","RUN = {\n","    'xresnet1d101':     True,   # Strodthoff baseline (exact protocol)\n","    'inception1d':      True,   # Strodthoff baseline\n","    'cpc':              True,   # Mehari: CPC pretrain -> two-step finetune\n","    'mtecg':            True,   # MTECG: masked-transformer pretrain -> finetune\n","    'xresnet1d101_aug': True,   # ablation: xresnet + Mehari RRC/TimeOut (runs last; first to drop if short on time)\n","}\n","\n","# Preprocessing\n","BANDPASS = None          # None = benchmark protocol (no filter). Ablation: (0.5, 40.0)\n","STANDARDIZE = 'global'   # 'global' = benchmark (one scaler over all leads) | 'per_lead'\n","\n","# Optional extra *unlabeled* ECGs for SSL pretraining only (never labels, never PTB-XL test fold).\n","# Each entry: path to .npy of shape (N, 12, 10*SAMPLING_RATE), raw mV, same lead order as PTB-XL.\n","EXTRA_PRETRAIN_NPY = []\n","\n","CFG_CNN = dict(epochs=50, bs=128, lr=1e-2, wd=1e-2, window_s=2.5)                 # Strodthoff repo defaults\n","CFG_CPC = dict(d=512, steps=12, n_neg=128, n_anchor=128,                       # n_anchor: timesteps per sequence used in the loss\n","               pretrain_epochs=200, pretrain_bs=64, pretrain_lr=1e-4, wd=1e-3,     # Mehari: 10 s input, constant LR\n","               head_epochs=50, full_epochs=20, ft_bs=128, ft_lr=1e-3, window_s=2.5)\n","CFG_MTECG = dict(patch_s=0.05, dim=192, depth=12, heads=3,                         # MTECG-T, 50 ms segments\n","                 dec_dim=128, dec_depth=1, dec_heads=4, mask_ratio=0.25, target='norm',\n","                 pretrain_epochs=800, pretrain_warmup=40, pretrain_bs=256, pretrain_lr=1e-3, pretrain_wd=0.05,\n","                 ft_epochs=50, ft_warmup=5, ft_bs=256, ft_lr=1e-3, ft_wd=0.05, drop_path=0.4, layer_decay=0.6)\n","# MTECG paper pretrains 1600 epochs and reports saturation near ~1000; 800 is a time/accuracy trade-off.\n","\n","N_BOOTSTRAP = 1000       # Strodthoff used 10,000; 1000 is enough for 95% CIs to ~3rd decimal\n","EVAL_BS = 256\n","\n","CACHE_DIR = Path('./ptbxl_cache')\n","OUT_DIR = Path('./ptbxl_runs') / f'{TASK}_{SAMPLING_RATE}hz'\n","CACHE_DIR.mkdir(parents=True, exist_ok=True); OUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","if QUICK_DEBUG:\n","    CFG_CNN.update(epochs=2)\n","    CFG_CPC.update(pretrain_epochs=2, head_epochs=2, full_epochs=1)\n","    CFG_MTECG.update(pretrain_epochs=2, pretrain_warmup=1, ft_epochs=2, ft_warmup=1)\n","    N_BOOTSTRAP = 50\n","    OUT_DIR = OUT_DIR.parent / (OUT_DIR.name + '_debug'); OUT_DIR.mkdir(parents=True, exist_ok=True)\n","\n","T_START = time.time()\n","def time_left():\n","    return float('inf') if TIME_BUDGET_H is None else TIME_BUDGET_H * 3600 - (time.time() - T_START)\n","\n","import shutil\n","for root in map(Path, RESUME_FROM):\n","    run_dirs = [root] if (root / 'results.csv').exists() or any(root.glob('*_val.npy')) or any(root.glob('*ckpt.pt')) \\\n","               else [d for d in root.rglob(OUT_DIR.name) if d.is_dir()]\n","    for d in run_dirs:\n","        n = 0\n","        for f in d.iterdir():\n","            if f.is_file() and not (OUT_DIR / f.name).exists():\n","                shutil.copy2(f, OUT_DIR / f.name); n += 1\n","        print(f'resumed {n} files from {d}')\n","    for f in root.rglob(f'raw_{SAMPLING_RATE}hz.npy'):\n","        if not (CACHE_DIR / f.name).exists(): shutil.copy2(f, CACHE_DIR / f.name); print('resumed signal cache', f)\n","if TIME_BUDGET_H: print(f'time budget: {TIME_BUDGET_H} h (reserve {RESERVE_MIN} min)')"]},{"cell_type":"code","execution_count":3,"id":"1af34c04","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:12:48.779235Z","iopub.status.busy":"2026-11-26T08:12:48.77893Z","iopub.status.idle":"2026-11-26T08:12:49.096316Z","shell.execute_reply":"2026-11-26T08:12:49.095372Z"},"papermill":{"duration":0.324804,"end_time":"2026-11-26T08:12:49.098137+00:00","exception":false,"start_time":"2026-11-26T08:12:48.773333+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["GPUs: 2 ['Tesla T4', 'Tesla T4']\n","device: cuda | AMP: True torch.float16 | GradScaler: True\n"]}],"source":["def seed_everything(seed):\n","    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)\n","\n","if torch.cuda.is_available():\n","    DEVICE = torch.device('cuda')\n","    torch.backends.cudnn.benchmark = True\n","    torch.backends.cuda.matmul.allow_tf32 = True; torch.backends.cudnn.allow_tf32 = True\n","elif getattr(torch.backends, 'mps', None) is not None and torch.backends.mps.is_available():\n","    DEVICE = torch.device('mps')\n","else:\n","    DEVICE = torch.device('cpu')\n","\n","USE_AMP = DEVICE.type == 'cuda' and AMP != 'off'\n","# bf16 only on GPUs with native support (Ampere+, compute capability >= 8). T4/P100 'support' it via slow, imprecise emulation.\n","AMP_DTYPE = torch.bfloat16 if (USE_AMP and torch.cuda.get_device_capability(0)[0] >= 8) else torch.float16\n","\n","def autocast():\n","    return torch.autocast(device_type='cuda', dtype=AMP_DTYPE, enabled=USE_AMP) if USE_AMP else torch.autocast('cpu', enabled=False)\n","\n","def make_scaler():\n","    enabled = USE_AMP and AMP_DTYPE == torch.float16\n","    try:    return torch.amp.GradScaler('cuda', enabled=enabled)\n","    except Exception: return torch.cuda.amp.GradScaler(enabled=enabled)\n","\n","N_GPUS = torch.cuda.device_count() if DEVICE.type == 'cuda' else 0\n","def dp(model):\n","    return nn.DataParallel(model) if (USE_MULTI_GPU and N_GPUS > 1) else model\n","\n","class OutOfTime(Exception): pass\n","\n","seed_everything(SEED)\n","print('GPUs:', N_GPUS, [torch.cuda.get_device_name(i) for i in range(N_GPUS)])\n","print('device:', DEVICE, '| AMP:', USE_AMP, AMP_DTYPE if USE_AMP else '',\n","      '| GradScaler:', USE_AMP and AMP_DTYPE == torch.float16)"]},{"cell_type":"markdown","id":"824acbca","metadata":{"papermill":{"duration":0.003548,"end_time":"2026-11-26T08:12:49.10553+00:00","exception":false,"start_time":"2026-11-26T08:12:49.101982+00:00","status":"completed"},"tags":[]},"source":["## Stage 1 — Data, labels, split  *(Wagner 2020 + Strodthoff 2021)*\n","\n","- Raw WFDB signals ek baar padh ke `.npy` cache ho jaate hain (pehli baar kuch minute lagenge).\n","- Label aggregation benchmark code jaisa hi: `scp_codes` ke keys, `scp_statements.csv` se diagnostic/form/rhythm filter, sub/super class mapping. Likelihood threshold **nahi** lagaya (benchmark bhi nahi lagata).\n","- Sirf woh records rakhe jaate hain jinke paas selected task ka ≥1 label hai.\n","- Split: folds 1–8 train, 9 val, 10 test. Folds patient-wise hain → leakage nahi."]},{"cell_type":"code","execution_count":4,"id":"f82a751b","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:12:49.113854Z","iopub.status.busy":"2026-11-26T08:12:49.113496Z","iopub.status.idle":"2026-11-26T08:15:30.614883Z","shell.execute_reply":"2026-11-26T08:15:30.613871Z"},"papermill":{"duration":161.507583,"end_time":"2026-11-26T08:15:30.616588+00:00","exception":false,"start_time":"2026-11-26T08:12:49.109005+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"2d98503352954e3888baaf403643e97c","version_major":2,"version_minor":0},"text/plain":["reading WFDB @100Hz:   0%|          | 0/21837 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["signal check: all values finite\n","records: 21837 | with all label: 21837 | classes: 71\n","train 17441 | val 2193 | test 2203 | signal shape (1000, 12)\n"]}],"source":["def load_raw(path, sr):\n","    df = pd.read_csv(os.path.join(path, 'ptbxl_database.csv'), index_col='ecg_id')\n","    df['scp_codes'] = df['scp_codes'].apply(ast.literal_eval)\n","    cache = CACHE_DIR / f'raw_{sr}hz.npy'\n","    if cache.exists():\n","        X = np.load(cache, mmap_mode=None)\n","        if len(X) == len(df):\n","            return df, X\n","    files = df['filename_lr'] if sr == 100 else df['filename_hr']\n","    def _read(f): return wfdb.rdsamp(os.path.join(path, f))[0].astype(np.float32)\n","    with ThreadPoolExecutor(max_workers=8) as ex:\n","        sigs = list(tqdm(ex.map(_read, files), total=len(files), desc=f'reading WFDB @{sr}Hz'))\n","    X = np.stack(sigs)                     # (N, L, 12)\n","    np.save(cache, X)\n","    return df, X\n","\n","def aggregate_labels(df, path, task):\n","    agg = pd.read_csv(os.path.join(path, 'scp_statements.csv'), index_col=0)\n","    if task in ('diagnostic', 'subdiagnostic', 'superdiagnostic'):\n","        dag = agg[agg.diagnostic == 1.0]\n","        col = {'diagnostic': None, 'subdiagnostic': 'diagnostic_subclass', 'superdiagnostic': 'diagnostic_class'}[task]\n","        def f(d):\n","            out = []\n","            for k in d:\n","                if k in dag.index:\n","                    v = k if col is None else dag.loc[k, col]\n","                    if isinstance(v, str) or not pd.isna(v): out.append(v)\n","            return sorted(set(out))\n","    elif task in ('form', 'rhythm'):\n","        sel = agg[agg[task] == 1.0]\n","        def f(d): return sorted({k for k in d if k in sel.index})\n","    elif task == 'all':\n","        def f(d): return sorted(set(d.keys()))\n","    else:\n","        raise ValueError(task)\n","    return df['scp_codes'].apply(f)\n","\n","df_all, X_raw = load_raw(DATA_PATH, SAMPLING_RATE)\n","_bad = ~np.isfinite(X_raw)\n","if _bad.any():\n","    _recs = np.where(_bad.any(axis=(1, 2)))[0]\n","    print(f'WARNING: {_bad.sum()} non-finite samples in {len(_recs)} records (ecg_id e.g. {df_all.index[_recs[:5]].tolist()}) -> set to 0')\n","    X_raw = np.nan_to_num(X_raw, nan=0.0, posinf=0.0, neginf=0.0)\n","else:\n","    print('signal check: all values finite')\n","del _bad\n","labels_all = aggregate_labels(df_all, DATA_PATH, TASK)\n","has_label = labels_all.apply(len).values > 0\n","folds_all = df_all['strat_fold'].values\n","\n","mlb = MultiLabelBinarizer()\n","mlb.fit(labels_all[has_label])\n","CLASSES = list(mlb.classes_)\n","N_CLASSES = len(CLASSES)\n","Y_all = mlb.transform(labels_all).astype(np.float32)\n","\n","idx_tr = np.where(has_label & (folds_all <= 8))[0]\n","idx_va = np.where(has_label & (folds_all == 9))[0]\n","idx_te = np.where(has_label & (folds_all == 10))[0]\n","print(f'records: {len(df_all)} | with {TASK} label: {has_label.sum()} | classes: {N_CLASSES}')\n","print(f'train {len(idx_tr)} | val {len(idx_va)} | test {len(idx_te)} | signal shape {X_raw.shape[1:]}')"]},{"cell_type":"markdown","id":"59560bfa","metadata":{"papermill":{"duration":0.004015,"end_time":"2026-11-26T08:15:30.624489+00:00","exception":false,"start_time":"2026-11-26T08:15:30.620474+00:00","status":"completed"},"tags":[]},"source":["## Stage 2 — Preprocessing  *(Strodthoff 2021)*\n","\n","- Benchmark protocol: **koi filter nahi**, ek global `StandardScaler` jo sirf train-fold values pe fit hota hai. `BANDPASS` / `STANDARDIZE='per_lead'` ablation ke liye diye hain — paper mein inka claim nahi hai, isliye baseline ke liye default mat badlo.\n","- Scaler sab records pe apply hota hai (SSL pretraining unlabeled train-fold records bhi use karta hai).\n","- Layout `(N, 12, L)` — PyTorch Conv1d channels-first."]},{"cell_type":"code","execution_count":5,"id":"821353d6","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:30.633876Z","iopub.status.busy":"2026-11-26T08:15:30.633266Z","iopub.status.idle":"2026-11-26T08:15:34.275958Z","shell.execute_reply":"2026-11-26T08:15:34.275001Z"},"papermill":{"duration":3.649368,"end_time":"2026-11-26T08:15:34.277753+00:00","exception":false,"start_time":"2026-11-26T08:15:30.628385+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["scaler: mean -0.0008 | std 0.2362\n","SSL pool: (17441, 12, 1000) | SSL val: (2193, 12, 1000) | stored on cuda\n"]}],"source":["def bandpass(X, fs, lo, hi, order=3):\n","    sos = butter(order, [lo, hi], btype='band', fs=fs, output='sos')\n","    return sosfiltfilt(sos, X, axis=1).astype(np.float32)\n","\n","X_proc = X_raw.copy()\n","if BANDPASS is not None:\n","    X_proc = bandpass(X_proc, SAMPLING_RATE, *BANDPASS)\n","\n","fit_ref = X_proc[idx_tr]                                   # labelled train folds only\n","if STANDARDIZE == 'global':\n","    MU, SD = float(fit_ref.mean(dtype=np.float64)), float(fit_ref.std(dtype=np.float64))\n","elif STANDARDIZE == 'per_lead':\n","    MU = fit_ref.mean(axis=(0, 1), keepdims=True, dtype=np.float64).astype(np.float32)\n","    SD = fit_ref.std(axis=(0, 1), keepdims=True, dtype=np.float64).astype(np.float32)\n","else:\n","    raise ValueError(STANDARDIZE)\n","del fit_ref\n","assert np.all(np.isfinite(MU)) and np.all(np.isfinite(SD)), f'scaler is not finite: MU={MU}, SD={SD}'\n","print('scaler: mean', np.round(MU, 4), '| std', np.round(SD, 4))\n","\n","def standardize(X):  # X: (N, L, 12) raw\n","    return ((X - MU) / (SD + 1e-8)).astype(np.float32)\n","\n","X_std = np.ascontiguousarray(standardize(X_proc).transpose(0, 2, 1))   # (N, 12, L)\n","del X_proc\n","SIG_LEN = X_std.shape[-1]\n","\n","# keep signals on GPU if they fit (~1 GB at 100 Hz) -> no DataLoader bottleneck\n","STORE = DEVICE if (DEVICE.type == 'cuda' and X_std.nbytes < 4e9) else torch.device('cpu')\n","X_t = torch.from_numpy(X_std).to(STORE)\n","Y_t = torch.from_numpy(Y_all).to(STORE)\n","\n","def subset(idx): return X_t[torch.as_tensor(idx, device=STORE)], Y_t[torch.as_tensor(idx, device=STORE)]\n","Xtr, Ytr = subset(idx_tr); Xva, Yva = subset(idx_va); Xte, Yte = subset(idx_te)\n","Y_val_np, Y_test_np = Y_all[idx_va], Y_all[idx_te]\n","\n","# Unlabeled pool for SSL: every train-fold record (also those without a label for this TASK) + optional extra data\n","idx_unl = np.where(folds_all <= 8)[0]\n","idx_unl_val = np.where(folds_all == 9)[0]\n","X_unl = X_t[torch.as_tensor(idx_unl, device=STORE)]\n","for p in EXTRA_PRETRAIN_NPY:\n","    ext = np.load(p).astype(np.float32)                    # (N, 12, L) raw\n","    assert ext.shape[1] == 12 and ext.shape[2] == SIG_LEN, f'{p}: expected (N,12,{SIG_LEN}), got {ext.shape}'\n","    if BANDPASS is not None: ext = bandpass(ext.transpose(0, 2, 1), SAMPLING_RATE, *BANDPASS).transpose(0, 2, 1)\n","    ext = standardize(ext.transpose(0, 2, 1)).transpose(0, 2, 1)\n","    X_unl = torch.cat([X_unl, torch.from_numpy(np.ascontiguousarray(ext)).to(STORE)])\n","X_unl_val = X_t[torch.as_tensor(idx_unl_val, device=STORE)]\n","print('SSL pool:', tuple(X_unl.shape), '| SSL val:', tuple(X_unl_val.shape), '| stored on', STORE)"]},{"cell_type":"markdown","id":"334690a4","metadata":{"papermill":{"duration":0.004267,"end_time":"2026-11-26T08:15:34.28606+00:00","exception":false,"start_time":"2026-11-26T08:15:34.281793+00:00","status":"completed"},"tags":[]},"source":["## Stage 3 — Windowing + augmentation  *(Strodthoff 2021, Mehari & Strodthoff 2022)*\n","\n","- **Sliding-window training**: har step pe har record se random 2.5 s crop → itself an augmentation.\n","- **Mehari transformations** (batched on GPU): Random Resized Crop (50–100%), Time Out (≤50% zeroed) — unke SimCLR ablation mein best pair. Physio noise (baseline wander, EMG, baseline shift) bhi diya hai. Powerline (50/60 Hz) 100 Hz sampling pe Nyquist pe hai, isliye skip."]},{"cell_type":"code","execution_count":6,"id":"724e39dd","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:34.29636Z","iopub.status.busy":"2026-11-26T08:15:34.295734Z","iopub.status.idle":"2026-11-26T08:15:35.84309Z","shell.execute_reply":"2026-11-26T08:15:35.842071Z"},"papermill":{"duration":1.554536,"end_time":"2026-11-26T08:15:35.845122+00:00","exception":false,"start_time":"2026-11-26T08:15:34.290586+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["window batch: (4, 12, 250) (4, 71)\n"]}],"source":["def aug_rrc(x, lo=0.5, hi=1.0):\n","    B, C, L = x.shape\n","    scale = torch.empty(B, 1, device=x.device).uniform_(lo, hi)\n","    start = torch.rand(B, 1, device=x.device) * (1 - scale)\n","    u = torch.linspace(0, 1, L, device=x.device)[None]\n","    gx = (start + scale * u) * 2 - 1                                   # (B, L) in [-1, 1]\n","    grid = torch.stack([gx, torch.zeros_like(gx)], -1)[:, None]         # (B, 1, L, 2)\n","    return F.grid_sample(x[:, :, None], grid, mode='bilinear', align_corners=True)[:, :, 0]\n","\n","def aug_timeout(x, lo=0.0, hi=0.5):\n","    B, C, L = x.shape\n","    t = torch.empty(B, 1, device=x.device).uniform_(lo, hi)\n","    s = torch.rand(B, 1, device=x.device) * (1 - t)\n","    pos = torch.linspace(0, 1, L, device=x.device)[None]\n","    keep = ~((pos >= s) & (pos < s + t))\n","    return x * keep[:, None].to(x.dtype)\n","\n","def aug_gauss(x, std=0.05):          return x + std * torch.randn_like(x)\n","def aug_channel_resize(x, b=3.0):    return x * (b ** torch.empty(x.shape[0], x.shape[1], 1, device=x.device).uniform_(-1, 1))\n","\n","def aug_baseline_wander(x, fs=SAMPLING_RATE, amp=0.1, fmax=0.5, n=3):\n","    B, C, L = x.shape\n","    t = torch.arange(L, device=x.device)[None, None] / fs\n","    out = x\n","    for _ in range(n):\n","        f = torch.rand(B, 1, 1, device=x.device) * fmax\n","        ph = torch.rand(B, C, 1, device=x.device) * 2 * math.pi\n","        a = torch.rand(B, C, 1, device=x.device) * amp\n","        out = out + a * torch.sin(2 * math.pi * f * t + ph)\n","    return out\n","\n","def aug_emg(x, std=0.05):            return x + std * torch.rand(x.shape[0], x.shape[1], 1, device=x.device) * torch.randn_like(x)\n","\n","def aug_baseline_shift(x, amp=0.2, max_frac=0.3):\n","    B, C, L = x.shape\n","    t = torch.rand(B, 1, device=x.device) * max_frac\n","    s = torch.rand(B, 1, device=x.device) * (1 - t)\n","    pos = torch.linspace(0, 1, L, device=x.device)[None]\n","    step = ((pos >= s) & (pos < s + t)).to(x.dtype)[:, None]\n","    return x + step * (torch.rand(B, C, 1, device=x.device) * 2 - 1) * amp\n","\n","def _apply_p(fn, x, p):\n","    m = (torch.rand(x.shape[0], 1, 1, device=x.device) < p).to(x.dtype)\n","    return m * fn(x) + (1 - m) * x\n","\n","def mehari_aug(x, p=0.5, physio=False):\n","    x = _apply_p(aug_rrc, x, p)\n","    x = _apply_p(aug_timeout, x, p)\n","    if physio:\n","        x = _apply_p(aug_baseline_wander, x, p * 0.5)\n","        x = _apply_p(aug_emg, x, p * 0.5)\n","        x = _apply_p(aug_baseline_shift, x, p * 0.5)\n","    return x\n","\n","class WindowBatches:\n","    # Random fixed-length crops from full records, shuffled mini-batches, optional batched augmentation.\n","    def __init__(self, X, Y=None, bs=128, win=None, shuffle=True, aug=None, drop_last=True):\n","        self.X, self.Y, self.bs, self.shuffle, self.aug, self.drop_last = X, Y, bs, shuffle, aug, drop_last\n","        self.win = win or X.shape[-1]\n","    def __len__(self):\n","        n = len(self.X)\n","        return n // self.bs if self.drop_last else math.ceil(n / self.bs)\n","    def __iter__(self):\n","        n, L, C = len(self.X), self.X.shape[-1], self.X.shape[1]\n","        order = torch.randperm(n, device=self.X.device) if self.shuffle else torch.arange(n, device=self.X.device)\n","        for b in range(len(self)):\n","            idx = order[b * self.bs:(b + 1) * self.bs]\n","            xb = self.X[idx]\n","            if self.win < L:\n","                st = torch.randint(0, L - self.win + 1, (len(idx),), device=xb.device)\n","                ar = (st[:, None] + torch.arange(self.win, device=xb.device)[None])[:, None].expand(-1, C, -1)\n","                xb = torch.gather(xb, 2, ar)\n","            xb = xb.to(DEVICE, non_blocking=True)\n","            if self.aug is not None:\n","                xb = self.aug(xb)\n","            yield (xb, self.Y[idx].to(DEVICE, non_blocking=True)) if self.Y is not None else xb\n","\n","_x = next(iter(WindowBatches(Xtr, Ytr, bs=4, win=int(2.5 * SAMPLING_RATE), aug=lambda z: mehari_aug(z, p=1.0, physio=True))))\n","print('window batch:', tuple(_x[0].shape), tuple(_x[1].shape))"]},{"cell_type":"markdown","id":"16f0808f","metadata":{"papermill":{"duration":0.004104,"end_time":"2026-11-26T08:15:35.85397+00:00","exception":false,"start_time":"2026-11-26T08:15:35.849866+00:00","status":"completed"},"tags":[]},"source":["## Stage 4a — Supervised architectures  *(Strodthoff 2021)*\n","\n","- `xresnet1d101`: xresnet tricks (3-conv stem, AvgPool in shortcut, zero-init last BN), kernel size 5.\n","- `inception1d`: InceptionTime, depth 6, 32 filters, kernels 39/19/9, bottleneck 32, residual every 3 blocks.\n","- Dono ka head same: concat-pool (avg ⊕ max) → BN → Dropout 0.25 → Linear 128 → ReLU → BN → Dropout 0.5 → Linear."]},{"cell_type":"code","execution_count":7,"id":"a22c8877","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:35.86285Z","iopub.status.busy":"2026-11-26T08:15:35.862556Z","iopub.status.idle":"2026-11-26T08:15:36.644951Z","shell.execute_reply":"2026-11-26T08:15:36.643887Z"},"papermill":{"duration":0.78901,"end_time":"2026-11-26T08:15:36.646767+00:00","exception":false,"start_time":"2026-11-26T08:15:35.857757+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["xresnet1d101: 33.56M params, out (2, 71)\n","inception1d: 0.52M params, out (2, 71)\n"]}],"source":["class ConcatPoolHead(nn.Module):\n","    def __init__(self, nf, n_out, hidden=128, ps=(0.25, 0.5)):\n","        super().__init__()\n","        self.layers = nn.Sequential(\n","            nn.BatchNorm1d(2 * nf), nn.Dropout(ps[0]), nn.Linear(2 * nf, hidden), nn.ReLU(inplace=True),\n","            nn.BatchNorm1d(hidden), nn.Dropout(ps[1]), nn.Linear(hidden, n_out))\n","    def forward(self, x):\n","        return self.layers(torch.cat([F.adaptive_avg_pool1d(x, 1), F.adaptive_max_pool1d(x, 1)], 1).flatten(1))\n","\n","class ConvBN(nn.Sequential):\n","    def __init__(self, ni, nf, ks=5, stride=1, act=True, zero_bn=False):\n","        bn = nn.BatchNorm1d(nf); nn.init.constant_(bn.weight, 0. if zero_bn else 1.)\n","        layers = [nn.Conv1d(ni, nf, ks, stride, padding=ks // 2, bias=False), bn]\n","        if act: layers.append(nn.ReLU(inplace=True))\n","        super().__init__(*layers)\n","\n","class XResBlock(nn.Module):\n","    def __init__(self, expansion, ni, nf, stride=1, ks=5):\n","        super().__init__()\n","        nin, nout = ni * expansion, nf * expansion\n","        if expansion == 1:\n","            convs = [ConvBN(nin, nf, ks, stride), ConvBN(nf, nout, ks, act=False, zero_bn=True)]\n","        else:\n","            convs = [ConvBN(nin, nf, 1), ConvBN(nf, nf, ks, stride), ConvBN(nf, nout, 1, act=False, zero_bn=True)]\n","        self.convs = nn.Sequential(*convs)\n","        idp = []\n","        if stride != 1: idp.append(nn.AvgPool1d(2, ceil_mode=True))\n","        if nin != nout: idp.append(ConvBN(nin, nout, 1, act=False))\n","        self.idpath = nn.Sequential(*idp)\n","    def forward(self, x): return F.relu(self.convs(x) + self.idpath(x))\n","\n","class XResNet1d(nn.Module):\n","    def __init__(self, expansion, layers, c_in=12, n_out=71, ks=5, ks_stem=5, stem=(32, 32, 64)):\n","        super().__init__()\n","        sz = [c_in, *stem]\n","        self.stem = nn.Sequential(*[ConvBN(sz[i], sz[i + 1], ks_stem, stride=2 if i == 0 else 1) for i in range(3)],\n","                                  nn.MaxPool1d(3, 2, 1))\n","        bs = [64 // expansion, 64, 128, 256, 512]\n","        blocks = []\n","        for i, l in enumerate(layers):\n","            for j in range(l):\n","                blocks.append(XResBlock(expansion, bs[i] if j == 0 else bs[i + 1], bs[i + 1],\n","                                        stride=1 if (i == 0 or j > 0) else 2, ks=ks))\n","        self.body = nn.Sequential(*blocks)\n","        self.head = ConcatPoolHead(bs[-1] * expansion, n_out)\n","    def forward(self, x): return self.head(self.body(self.stem(x)))\n","\n","def xresnet1d50(**kw):  return XResNet1d(4, [3, 4, 6, 3], **kw)\n","def xresnet1d101(**kw): return XResNet1d(4, [3, 4, 23, 3], **kw)\n","\n","class InceptionBlock1d(nn.Module):\n","    def __init__(self, ni, nb_filters=32, kss=(39, 19, 9), bottleneck=32):\n","        super().__init__()\n","        self.bottleneck = nn.Conv1d(ni, bottleneck, 1, bias=False) if bottleneck > 0 else nn.Identity()\n","        bi = bottleneck if bottleneck > 0 else ni\n","        self.convs = nn.ModuleList([nn.Conv1d(bi, nb_filters, k, padding=k // 2, bias=False) for k in kss])\n","        self.pool_conv = nn.Sequential(nn.MaxPool1d(3, 1, 1), nn.Conv1d(ni, nb_filters, 1, bias=False))\n","        self.bn = nn.BatchNorm1d((len(kss) + 1) * nb_filters)\n","    def forward(self, x):\n","        b = self.bottleneck(x)\n","        return F.relu(self.bn(torch.cat([c(b) for c in self.convs] + [self.pool_conv(x)], 1)))\n","\n","class Shortcut1d(nn.Module):\n","    def __init__(self, ni, nf):\n","        super().__init__(); self.conv = nn.Conv1d(ni, nf, 1, bias=False); self.bn = nn.BatchNorm1d(nf)\n","    def forward(self, inp, out): return F.relu(out + self.bn(self.conv(inp)))\n","\n","class Inception1d(nn.Module):\n","    def __init__(self, c_in=12, n_out=71, depth=6, nb_filters=32, kernel_size=40, bottleneck=32):\n","        super().__init__()\n","        kss = [kernel_size - 1, kernel_size // 2 - 1, kernel_size // 4 - 1]\n","        nf = (len(kss) + 1) * nb_filters\n","        self.blocks = nn.ModuleList([InceptionBlock1d(c_in if d == 0 else nf, nb_filters, kss, bottleneck) for d in range(depth)])\n","        self.shortcuts = nn.ModuleList([Shortcut1d(c_in if d == 0 else nf, nf) for d in range(depth // 3)])\n","        self.head = ConcatPoolHead(nf, n_out)\n","    def forward(self, x):\n","        res = x\n","        for d, blk in enumerate(self.blocks):\n","            x = blk(x)\n","            if d % 3 == 2:\n","                x = self.shortcuts[d // 3](res, x); res = x\n","        return self.head(x)\n","\n","for name, m in [('xresnet1d101', xresnet1d101(n_out=N_CLASSES)), ('inception1d', Inception1d(n_out=N_CLASSES))]:\n","    print(f'{name}: {sum(p.numel() for p in m.parameters())/1e6:.2f}M params, out', tuple(m(torch.randn(2, 12, 250)).shape))"]},{"cell_type":"markdown","id":"24e8c13b","metadata":{"papermill":{"duration":0.00443,"end_time":"2026-11-26T08:15:36.65585+00:00","exception":false,"start_time":"2026-11-26T08:15:36.65142+00:00","status":"completed"},"tags":[]},"source":["## Stage 4b — Contrastive Predictive Coding  *(Mehari & Strodthoff 2022)*\n","\n","- Encoder: per-timestep 4 × (Linear 512 + BN + ReLU) — 100 Hz pe strided conv ki zaroorat nahi.\n","- Context: 2-layer LSTM (512). Predictor: extra hidden layer + ReLU (unka \"enhanced CPC\").\n","- InfoNCE: 12 steps (0.12 s) aage predict, 128 negatives same sequence se.\n","- Finetune head: concat-pool (max ⊕ mean ⊕ last LSTM output) → 512 hidden, BN, dropout."]},{"cell_type":"code","execution_count":8,"id":"241ac0b4","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:36.664958Z","iopub.status.busy":"2026-11-26T08:15:36.664718Z","iopub.status.idle":"2026-11-26T08:15:36.904213Z","shell.execute_reply":"2026-11-26T08:15:36.903487Z"},"papermill":{"duration":0.245775,"end_time":"2026-11-26T08:15:36.905749+00:00","exception":false,"start_time":"2026-11-26T08:15:36.659974+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["CPC: 9.24M params | loss on random input: 2.916\n"]}],"source":["class CPCModel(nn.Module):\n","    def __init__(self, c_in=12, d=512, n_enc=4, lstm_layers=2, steps=12, n_out=None):\n","        super().__init__()\n","        layers, ni = [], c_in\n","        for _ in range(n_enc):\n","            layers += [nn.Conv1d(ni, d, 1, bias=False), nn.BatchNorm1d(d), nn.ReLU(inplace=True)]; ni = d\n","        self.encoder = nn.Sequential(*layers)\n","        self.rnn = nn.LSTM(d, d, lstm_layers, batch_first=True)\n","        self.d, self.steps = d, steps\n","        self.proj = nn.Sequential(nn.Linear(d, d), nn.ReLU(inplace=True), nn.Linear(d, d * steps))\n","        self.head = None\n","        if n_out is not None: self.add_head(n_out)\n","\n","    def add_head(self, n_out, hidden=512, ps=(0.25, 0.5)):\n","        self.head = nn.Sequential(nn.BatchNorm1d(3 * self.d), nn.Dropout(ps[0]), nn.Linear(3 * self.d, hidden),\n","                                  nn.ReLU(inplace=True), nn.BatchNorm1d(hidden), nn.Dropout(ps[1]), nn.Linear(hidden, n_out))\n","\n","    def _context(self, x):\n","        z = self.encoder(x).transpose(1, 2)                      # (B, T, d)\n","        with torch.autocast(device_type=x.device.type, enabled=False):\n","            c, _ = self.rnn(z.float())                           # LSTM in fp32 (AMP-safe)\n","        return z, c\n","\n","    def cpc_loss(self, x, n_neg=128, n_anchor=128):\n","        # InfoNCE on a random subset of anchor timesteps per sequence (unbiased estimate of the full loss).\n","        # Predicting 12 x 512-d vectors for all 1000 timesteps was the memory bottleneck.\n","        z, c = self._context(x)\n","        B, T, D = z.shape\n","        with torch.autocast(device_type=x.device.type, enabled=False):\n","            z, c = z.float(), c.float()\n","            h = self.proj[1](self.proj[0](c))                                  # shared hidden (B, T, D)\n","            W, b = self.proj[2].weight, self.proj[2].bias                       # step k uses rows (k-1)*D : k*D\n","            loss, acc = 0., 0.\n","            for k in range(1, self.steps + 1):\n","                nA = min(n_anchor, T - k)\n","                t = torch.randint(0, T - k, (B, nA), device=x.device)\n","                hk = torch.gather(h, 1, t[:, :, None].expand(-1, -1, D))\n","                p = F.linear(hk, W[(k - 1) * D:k * D], b[(k - 1) * D:k * D])     # (B, nA, D)\n","                zp = torch.gather(z, 1, (t + k)[:, :, None].expand(-1, -1, D))\n","                pos = (p * zp).sum(-1, keepdim=True)                              # (B, nA, 1)\n","                neg_idx = torch.randint(0, T, (B, n_neg), device=x.device)        # negatives from the same sequence\n","                zn = torch.gather(z, 1, neg_idx[:, :, None].expand(-1, -1, D))    # (B, n_neg, D)\n","                logits = torch.cat([pos, torch.bmm(p, zn.transpose(1, 2))], 2).reshape(-1, 1 + n_neg)\n","                tgt = torch.zeros(len(logits), dtype=torch.long, device=x.device)\n","                loss = loss + F.cross_entropy(logits, tgt)\n","                acc = acc + (logits.argmax(1) == 0).float().mean()\n","        return loss / self.steps, acc / self.steps\n","\n","    def forward(self, x):\n","        _, c = self._context(x)\n","        pooled = torch.cat([c.max(1)[0], c.mean(1), c[:, -1]], 1)\n","        return self.head(pooled)\n","\n","_m = CPCModel(n_out=N_CLASSES)\n","print(f'CPC: {sum(p.numel() for p in _m.parameters())/1e6:.2f}M params | loss on random input:', round(_m.cpc_loss(torch.randn(2, 12, 200), 16)[0].item(), 3))"]},{"cell_type":"markdown","id":"671877ab","metadata":{"papermill":{"duration":0.003969,"end_time":"2026-11-26T08:15:36.913855+00:00","exception":false,"start_time":"2026-11-26T08:15:36.909886+00:00","status":"completed"},"tags":[]},"source":["## Stage 4c — Masked Transformer (MTECG)  *(Zhou et al.)*\n","\n","- 12 leads × 50 ms segment = ek token (paper: 25 samples @ 500 Hz = 5 samples @ 100 Hz → 10 s pe 200 tokens).\n","- Learnable positional embedding + aux (CLS) token. MTECG-T: D=192, 3 heads, 12 layers.\n","- Pretrain: 25% segments masked, 1-layer decoder (128-d, 4 heads), target = per-segment normalized signal.\n","- Finetune: global mean-pool of tokens → LayerNorm → Linear, DropPath 0.4, layer-wise LR decay 0.6."]},{"cell_type":"code","execution_count":9,"id":"7c9ba411","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:36.9231Z","iopub.status.busy":"2026-11-26T08:15:36.922634Z","iopub.status.idle":"2026-11-26T08:15:37.128921Z","shell.execute_reply":"2026-11-26T08:15:37.128232Z"},"papermill":{"duration":0.212669,"end_time":"2026-11-26T08:15:37.130432+00:00","exception":false,"start_time":"2026-11-26T08:15:36.917763+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["MTECG-T: 5.66M params | tokens: 200 | mae loss on random input: 2.411\n"]}],"source":["class DropPath(nn.Module):\n","    def __init__(self, p=0.): super().__init__(); self.p = p\n","    def forward(self, x):\n","        if self.p == 0. or not self.training: return x\n","        keep = 1 - self.p\n","        mask = x.new_empty((x.shape[0],) + (1,) * (x.ndim - 1)).bernoulli_(keep)\n","        return x * mask / keep\n","\n","class Attention(nn.Module):\n","    def __init__(self, dim, heads):\n","        super().__init__(); self.h = heads; self.qkv = nn.Linear(dim, dim * 3); self.proj = nn.Linear(dim, dim)\n","    def forward(self, x):\n","        B, N, C = x.shape\n","        q, k, v = self.qkv(x).reshape(B, N, 3, self.h, C // self.h).permute(2, 0, 3, 1, 4)\n","        return self.proj(F.scaled_dot_product_attention(q, k, v).transpose(1, 2).reshape(B, N, C))\n","\n","class Block(nn.Module):\n","    def __init__(self, dim, heads, mlp_ratio=4., drop_path=0.):\n","        super().__init__()\n","        self.norm1 = nn.LayerNorm(dim); self.attn = Attention(dim, heads)\n","        self.norm2 = nn.LayerNorm(dim)\n","        self.mlp = nn.Sequential(nn.Linear(dim, int(dim * mlp_ratio)), nn.GELU(), nn.Linear(int(dim * mlp_ratio), dim))\n","        self.dp = DropPath(drop_path)\n","    def forward(self, x):\n","        x = x + self.dp(self.attn(self.norm1(x)))\n","        return x + self.dp(self.mlp(self.norm2(x)))\n","\n","class MTECG(nn.Module):\n","    def __init__(self, c_in=12, seq_len=1000, patch=5, dim=192, depth=12, heads=3, drop_path=0.,\n","                 n_out=None, with_decoder=True, dec_dim=128, dec_depth=1, dec_heads=4):\n","        super().__init__()\n","        self.c_in, self.patch, self.T = c_in, patch, seq_len // patch\n","        self.patch_embed = nn.Linear(c_in * patch, dim)\n","        self.cls_token = nn.Parameter(torch.zeros(1, 1, dim))\n","        self.pos_embed = nn.Parameter(torch.zeros(1, self.T + 1, dim))\n","        dpr = torch.linspace(0, drop_path, depth).tolist()\n","        self.blocks = nn.ModuleList([Block(dim, heads, drop_path=dpr[i]) for i in range(depth)])\n","        self.norm = nn.LayerNorm(dim)\n","        self.with_decoder = with_decoder\n","        if with_decoder:\n","            self.dec_embed = nn.Linear(dim, dec_dim)\n","            self.mask_token = nn.Parameter(torch.zeros(1, 1, dec_dim))\n","            self.dec_pos = nn.Parameter(torch.zeros(1, self.T + 1, dec_dim))\n","            self.dec_blocks = nn.ModuleList([Block(dec_dim, dec_heads) for _ in range(dec_depth)])\n","            self.dec_norm = nn.LayerNorm(dec_dim)\n","            self.dec_pred = nn.Linear(dec_dim, c_in * patch)\n","        self.fc_norm = nn.LayerNorm(dim) if n_out else None\n","        self.head = nn.Linear(dim, n_out) if n_out else None\n","        self._init()\n","\n","    def _init(self):\n","        for p in [self.cls_token, self.pos_embed] + ([self.mask_token, self.dec_pos] if self.with_decoder else []):\n","            nn.init.trunc_normal_(p, std=.02)\n","        for m in self.modules():\n","            if isinstance(m, nn.Linear):\n","                nn.init.xavier_uniform_(m.weight)\n","                if m.bias is not None: nn.init.zeros_(m.bias)\n","            elif isinstance(m, nn.LayerNorm):\n","                nn.init.ones_(m.weight); nn.init.zeros_(m.bias)\n","        if self.head is not None:\n","            nn.init.trunc_normal_(self.head.weight, std=2e-5)\n","\n","    def patchify(self, x):                     # (B, C, L) -> (B, T, C*patch)\n","        B, C, L = x.shape\n","        return x[:, :, :self.T * self.patch].reshape(B, C, self.T, self.patch).permute(0, 2, 1, 3).reshape(B, self.T, C * self.patch)\n","\n","    def encode(self, x, mask_ratio=0.):\n","        t = self.patch_embed(self.patchify(x)) + self.pos_embed[:, 1:]\n","        B, T, D = t.shape\n","        mask = ids_restore = None\n","        if mask_ratio > 0:\n","            n_keep = max(1, int(T * (1 - mask_ratio)))\n","            ids_shuffle = torch.argsort(torch.rand(B, T, device=x.device), 1)\n","            ids_restore = torch.argsort(ids_shuffle, 1)\n","            t = torch.gather(t, 1, ids_shuffle[:, :n_keep, None].expand(-1, -1, D))\n","            mask = torch.ones(B, T, device=x.device); mask[:, :n_keep] = 0\n","            mask = torch.gather(mask, 1, ids_restore)\n","        cls = (self.cls_token + self.pos_embed[:, :1]).expand(B, -1, -1)\n","        h = torch.cat([cls, t], 1)\n","        for blk in self.blocks: h = blk(h)\n","        return self.norm(h), mask, ids_restore\n","\n","    def decode(self, h, ids_restore):\n","        h = self.dec_embed(h)\n","        B, _, D = h.shape\n","        mt = self.mask_token.expand(B, self.T + 1 - h.shape[1], -1)\n","        h_ = torch.cat([h[:, 1:], mt], 1)\n","        h_ = torch.gather(h_, 1, ids_restore[:, :, None].expand(-1, -1, D))\n","        h = torch.cat([h[:, :1], h_], 1) + self.dec_pos\n","        for blk in self.dec_blocks: h = blk(h)\n","        return self.dec_pred(self.dec_norm(h))[:, 1:]\n","\n","    def mae_loss(self, x, mask_ratio=0.25, target='norm'):\n","        h, mask, ids = self.encode(x, mask_ratio)\n","        pred = self.decode(h, ids).float()\n","        tgt = self.patchify(x).float()\n","        if target == 'norm':\n","            mu, var = tgt.mean(-1, keepdim=True), tgt.var(-1, keepdim=True)\n","            tgt = (tgt - mu) / (var + 1e-6).sqrt()\n","        elif target == 'sqrt':\n","            tgt = tgt.sign() * tgt.abs().sqrt()\n","        loss = ((pred - tgt) ** 2).mean(-1)\n","        return (loss * mask).sum() / mask.sum()\n","\n","    def forward(self, x):\n","        h, _, _ = self.encode(x, 0.)\n","        return self.head(self.fc_norm(h[:, 1:].mean(1)))\n","\n","MT_PATCH = max(1, int(round(CFG_MTECG['patch_s'] * SAMPLING_RATE)))\n","_m = MTECG(seq_len=SIG_LEN, patch=MT_PATCH, n_out=N_CLASSES)\n","print(f'MTECG-T: {sum(p.numel() for p in _m.parameters())/1e6:.2f}M params | tokens: {SIG_LEN // MT_PATCH} | '\n","      f'mae loss on random input: {_m.mae_loss(torch.randn(2, 12, SIG_LEN)).item():.3f}')\n","del _m"]},{"cell_type":"markdown","id":"f7c35940","metadata":{"papermill":{"duration":0.004252,"end_time":"2026-11-26T08:15:37.138773+00:00","exception":false,"start_time":"2026-11-26T08:15:37.134521+00:00","status":"completed"},"tags":[]},"source":["## Stage 5 — Training engine + evaluation  *(Strodthoff 2021)*\n","\n","- **TTA**: record ko window-size segments mein kaato (stride = window/2), predictions aggregate karo — benchmark `max` use karta hai, Mehari CPC `mean`.\n","- **Model selection**: best validation macro AUC (fold 9). Test fold 10 sirf end mein.\n","- **Metrics**: term-centric macro AUC (primary), macro-F1 + F<sub>β=2</sub> / G<sub>β=2</sub> (PhysioNet/CinC challenge style) — thresholds *validation* pe tune, test pe apply.\n","- **Bootstrap**: same resampled indices sab models ke liye (paired). Woh resamples discard jinmein koi class ka positive na ho (benchmark rule)."]},{"cell_type":"code","execution_count":10,"id":"cf50c938","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:37.149512Z","iopub.status.busy":"2026-11-26T08:15:37.149229Z","iopub.status.idle":"2026-11-26T08:15:37.182169Z","shell.execute_reply":"2026-11-26T08:15:37.181565Z"},"papermill":{"duration":0.040224,"end_time":"2026-11-26T08:15:37.183637+00:00","exception":false,"start_time":"2026-11-26T08:15:37.143413+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["@torch.no_grad()\n","def predict(model, X, window, stride=None, agg='max', bs=EVAL_BS):\n","    model.eval(); net = dp(model)\n","    L = X.shape[-1]; window = min(window, L); stride = stride or max(1, window // 2)\n","    starts = list(range(0, L - window + 1, stride))\n","    if starts[-1] != L - window: starts.append(L - window)\n","    out = []\n","    per = max(1, bs // len(starts))\n","    for i in range(0, len(X), per):\n","        xb = X[i:i + per].to(DEVICE, non_blocking=True)\n","        w = torch.stack([xb[:, :, s:s + window] for s in starts], 1).flatten(0, 1)\n","        with autocast():\n","            logits = net(w).float()\n","        if not torch.isfinite(logits).all():                      # fp16 overflow -> redo this batch in fp32\n","            logits = net(w.float()).float()\n","        if not torch.isfinite(logits).all():\n","            raise FloatingPointError('model produces non-finite outputs even in fp32 -> weights diverged')\n","        p = torch.sigmoid(logits).view(len(xb), len(starts), -1)\n","        out.append((p.max(1)[0] if agg == 'max' else p.mean(1)).cpu())\n","    return torch.cat(out).numpy()\n","\n","def macro_auc(y, p):\n","    pos = y.sum(0); cols = (pos > 0) & (pos < len(y))\n","    return roc_auc_score(y[:, cols], p[:, cols], average='macro')\n","\n","def per_class_auc(y, p):\n","    return np.array([roc_auc_score(y[:, j], p[:, j]) if 0 < y[:, j].sum() < len(y) else np.nan for j in range(y.shape[1])])\n","\n","def tune_thresholds(y, p, grid=np.linspace(0.01, 0.99, 99)):\n","    th = np.zeros(y.shape[1])\n","    for j in range(y.shape[1]):\n","        yp = p[:, j][:, None] >= grid[None]\n","        tp = (yp & (y[:, j][:, None] == 1)).sum(0); fp = (yp & (y[:, j][:, None] == 0)).sum(0)\n","        fn = ((~yp) & (y[:, j][:, None] == 1)).sum(0)\n","        f1 = 2 * tp / np.maximum(2 * tp + fp + fn, 1)\n","        th[j] = grid[f1.argmax()]\n","    return th\n","\n","def threshold_metrics(y, yhat, beta=2.):\n","    y, yhat = y.astype(bool), yhat.astype(bool)\n","    present = y.sum(0) > 0                                                 # classes with >=1 positive\n","    y_c, yhat_c = y[:, present], yhat[:, present]\n","    tp, fp, fn = (y_c & yhat_c).sum(0), (~y_c & yhat_c).sum(0), (y_c & ~yhat_c).sum(0)\n","    f1 = np.mean(2 * tp / np.maximum(2 * tp + fp + fn, 1))\n","    w = 1. / np.maximum(y.sum(1, keepdims=True), 1)                        # challenge sample weighting\n","    TP, FP, FN = (w * (y_c & yhat_c)).sum(0), (w * (~y_c & yhat_c)).sum(0), (w * (y_c & ~yhat_c)).sum(0)\n","    fb = np.mean((1 + beta**2) * TP / np.maximum((1 + beta**2) * TP + FP + beta**2 * FN, 1e-12))\n","    gb = np.mean(TP / np.maximum(TP + FP + beta * FN, 1e-12))\n","    return dict(macro_F1=f1, F_beta2=fb, G_beta2=gb)\n","\n","def bootstrap_indices(y, n, seed=SEED, max_tries_factor=50):\n","    rng = np.random.default_rng(seed); out, tries = [], 0\n","    while len(out) < n and tries < n * max_tries_factor:\n","        idx = rng.integers(0, len(y), len(y)); tries += 1\n","        if y[idx].sum(0).min() > 0: out.append(idx)\n","    if len(out) < n:\n","        print(f'  note: only {len(out)}/{n} resamples contain every class (rare labels); rest use classes present')\n","        out += [rng.integers(0, len(y), len(y)) for _ in range(n - len(out))]\n","    return out\n","\n","def cosine_warmup(total, warmup):\n","    def f(step):\n","        if step < warmup: return (step + 1) / max(1, warmup)\n","        return 0.5 * (1 + math.cos(math.pi * (step - warmup) / max(1, total - warmup)))\n","    return f\n","\n","def train_classifier(model, *, name, param_groups, epochs, bs, win, sched='onecycle', warmup_epochs=0,\n","                     aug=None, eval_win=None, agg='max', betas=(0.9, 0.99), select_on='auc'):\n","    model.to(DEVICE)\n","    done_f, ckpt_f = OUT_DIR / f'{name}_done.pt', OUT_DIR / f'{name}_train_ckpt.pt'\n","    if done_f.exists() and not FORCE_RETRAIN:\n","        s = torch.load(done_f, map_location=DEVICE); model.load_state_dict(s['model'])\n","        print(f'[{name}] stage already finished (val macroAUC {s[\"best\"]:.4f}), loaded'); return model, s['best']\n","    opt = torch.optim.AdamW(param_groups, betas=betas)\n","    it = WindowBatches(Xtr, Ytr, bs=bs, win=win, aug=aug)\n","    net = dp(model)\n","    total = epochs * len(it)\n","    if sched == 'onecycle':\n","        sch = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=[g['lr'] for g in param_groups], total_steps=total,\n","                                                  pct_start=0.25, div_factor=25., final_div_factor=1e4)\n","    elif sched == 'cosine':\n","        sch = torch.optim.lr_scheduler.LambdaLR(opt, cosine_warmup(total, warmup_epochs * len(it)))\n","    else:\n","        sch = None\n","    scaler = make_scaler()\n","    best, best_state, hist, start, last_ep_s = -1, None, [], 0, 0.\n","    init_state, n_rollback, MAX_ROLLBACK = copy.deepcopy(model.state_dict()), 0, 3\n","    if ckpt_f.exists() and not FORCE_RETRAIN:\n","        s = torch.load(ckpt_f, map_location=DEVICE)\n","        model.load_state_dict(s['model']); opt.load_state_dict(s['opt'])\n","        if sch is not None: sch.load_state_dict(s['sched'])\n","        start, best, best_state, hist = s['epoch'], s['best'], s['best_state'], s['hist']\n","        print(f'[{name}] resuming from epoch {start}')\n","    for ep in range(start, epochs):\n","        if time_left() < RESERVE_MIN * 60 + 1.2 * last_ep_s:\n","            torch.save(dict(model=model.state_dict(), opt=opt.state_dict(), sched=sch.state_dict() if sch is not None else None,\n","                            epoch=ep, best=best, best_state=best_state, hist=hist), ckpt_f)\n","            raise OutOfTime(f'{name}: paused at epoch {ep}/{epochs}, checkpoint saved')\n","        model.train(); t0 = time.time(); run = 0.; n_ok = n_bad = 0\n","        for xb, yb in it:\n","            with autocast():\n","                loss = F.binary_cross_entropy_with_logits(net(xb).float(), yb)\n","            opt.zero_grad(set_to_none=True)\n","            if not torch.isfinite(loss):\n","                n_bad += 1\n","                if sch is not None: sch.step()\n","                continue\n","            scaler.scale(loss).backward()\n","            scaler.unscale_(opt); torch.nn.utils.clip_grad_norm_(model.parameters(), 10.0)\n","            scaler.step(opt); scaler.update()\n","            if sch is not None: sch.step()\n","            run += loss.item(); n_ok += 1\n","        # ---- divergence check: non-finite steps, NaN weights, non-finite outputs, or val-AUC collapse ----\n","        reason, auc = None, float('nan')\n","        if n_ok == 0 or n_bad > 0.05 * len(it): reason = f'{n_bad}/{len(it)} non-finite steps'\n","        elif not all(torch.isfinite(p).all() for p in model.parameters()): reason = 'non-finite weights'\n","        else:\n","            try:\n","                pv = predict(model, Xva, eval_win or win, agg=agg); auc = macro_auc(Y_val_np, pv)\n","                if best > 0 and auc < best - 0.15: reason = f'val AUC collapsed {best:.3f} -> {auc:.3f}'\n","            except FloatingPointError: reason = 'non-finite predictions'\n","        if reason is not None:\n","            n_rollback += 1\n","            if n_rollback > MAX_ROLLBACK:\n","                raise FloatingPointError(f'[{name}] diverged {n_rollback}x ({reason}); lower the LR or set AMP = \"off\"')\n","            model.load_state_dict(best_state if best_state is not None else init_state)\n","            opt.state.clear()                                        # drop possibly corrupted Adam moments\n","            for g in opt.param_groups:\n","                for k in ('lr', 'initial_lr', 'max_lr', 'min_lr'):\n","                    if k in g: g[k] *= 0.5\n","            if sch is not None and hasattr(sch, 'base_lrs'): sch.base_lrs = [b * 0.5 for b in sch.base_lrs]\n","            scaler = make_scaler()\n","            hist.append(dict(epoch=ep + 1, train_loss=float('nan'), val_auc=auc, rollback=reason))\n","            last_ep_s = time.time() - t0\n","            print(f'[{name}] ep {ep+1:3d}/{epochs} DIVERGED ({reason}) -> rolled back to best weights, LR x0.5 '\n","                  f'(rollback {n_rollback}/{MAX_ROLLBACK}) ({last_ep_s:.0f}s)')\n","            continue\n","        if n_bad: print(f'[{name}] skipped {n_bad} non-finite steps')\n","        run = run * len(it) / n_ok\n","        hist.append(dict(epoch=ep + 1, train_loss=run / len(it), val_auc=auc))\n","        flag = ''\n","        if auc > best:\n","            best, best_state, flag = auc, copy.deepcopy(model.state_dict()), ' *'\n","        last_ep_s = time.time() - t0\n","        print(f'[{name}] ep {ep+1:3d}/{epochs} loss {run/len(it):.4f} val macroAUC {auc:.4f}{flag} ({last_ep_s:.0f}s)')\n","    if best_state is None:\n","        raise FloatingPointError(f'[{name}] no healthy epoch at all; lower the LR or set AMP = \"off\"')\n","    model.load_state_dict(best_state)\n","    pd.DataFrame(hist).to_csv(OUT_DIR / f'{name}_history.csv', index=False)\n","    torch.save(dict(model=best_state, best=best), done_f)\n","    if ckpt_f.exists(): ckpt_f.unlink()\n","    return model, best\n","\n","RESULTS = {}   # name -> dict(val=probs, test=probs)\n","def run_experiment(name, fn):\n","    pv_f, pt_f = OUT_DIR / f'{name}_val.npy', OUT_DIR / f'{name}_test.npy'\n","    if pv_f.exists() and pt_f.exists() and not FORCE_RETRAIN:\n","        print(f'[{name}] loading saved predictions from {OUT_DIR}')\n","        RESULTS[name] = dict(val=np.load(pv_f), test=np.load(pt_f))\n","    else:\n","        if time_left() < RESERVE_MIN * 60:\n","            print(f'[{name}] skipped: not enough time left in this session (rerun with RESUME_FROM)'); return\n","        seed_everything(SEED); t0 = time.time()\n","        try:\n","            pv, pt = fn()\n","        except OutOfTime as e:\n","            print(f'[{name}] {e} -> continue next session with RESUME_FROM'); return\n","        np.save(pv_f, pv); np.save(pt_f, pt)\n","        RESULTS[name] = dict(val=pv, test=pt)\n","        print(f'[{name}] done in {(time.time()-t0)/60:.1f} min')\n","    r = RESULTS[name]\n","    print(f'[{name}] val macroAUC {macro_auc(Y_val_np, r[\"val\"]):.4f} | test macroAUC {macro_auc(Y_test_np, r[\"test\"]):.4f}')"]},{"cell_type":"markdown","id":"ead253c1","metadata":{"papermill":{"duration":0.003684,"end_time":"2026-11-26T08:15:37.191093+00:00","exception":false,"start_time":"2026-11-26T08:15:37.187409+00:00","status":"completed"},"tags":[]},"source":["## Experiment 1 — Supervised baselines  *(Strodthoff 2021 protocol)*\n","AdamW, one-cycle LR 1e-2, wd 1e-2, batch 128, 50 epochs, 2.5 s windows, TTA max. `_aug` variant pe Mehari RRC + TimeOut (p=0.5) lagta hai."]},{"cell_type":"code","execution_count":11,"id":"8e3b34db","metadata":{"execution":{"iopub.execute_input":"2026-11-26T08:15:37.19982Z","iopub.status.busy":"2026-11-26T08:15:37.199535Z","iopub.status.idle":"2026-11-26T09:19:08.915244Z","shell.execute_reply":"2026-11-26T09:19:08.913523Z"},"papermill":{"duration":3811.722861,"end_time":"2026-11-26T09:19:08.91774+00:00","exception":false,"start_time":"2026-11-26T08:15:37.194879+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[xresnet1d101] ep   1/50 loss 0.6996 val macroAUC 0.6514 * (67s)\n","[xresnet1d101] ep   2/50 loss 0.4541 val macroAUC 0.6485 (60s)\n","[xresnet1d101] ep   3/50 loss 0.1399 val macroAUC 0.7381 * (60s)\n","[xresnet1d101] ep   4/50 loss 0.0987 val macroAUC 0.7822 * (59s)\n","[xresnet1d101] ep   5/50 loss 0.0924 val macroAUC 0.8089 * (60s)\n","[xresnet1d101] ep   6/50 loss 0.0882 val macroAUC 0.8219 * (59s)\n","[xresnet1d101] ep   7/50 loss 0.0825 val macroAUC 0.8372 * (59s)\n","[xresnet1d101] ep   8/50 loss 0.0786 val macroAUC 0.8524 * (59s)\n","[xresnet1d101] ep   9/50 loss 0.0755 val macroAUC 0.8621 * (59s)\n","[xresnet1d101] ep  10/50 loss 0.0730 val macroAUC 0.875